# Copy to .env at the repository root. These values are for local development only.
# Do not put production passwords, API keys, or cloud credentials in this file.

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=shopkeep_development
MYSQL_TEST_DATABASE=shopkeep_test
MYSQL_USER=shopkeep
MYSQL_PASSWORD=shopkeep

REDIS_URL=redis://127.0.0.1:6379/0

# Comma-separated browser origins allowed to call the API with cookies.
CORS_ORIGINS=http://localhost:5173

# Used by the container app profile. Generate a local secret; do not reuse this placeholder in production.
SECRET_KEY_BASE=replace-with-bin-rails-secret
